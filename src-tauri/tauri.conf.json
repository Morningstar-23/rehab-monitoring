{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RehabMonitoring",
  "version": "1.0.0",
  "identifier": "com.rehabmonitoring.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "RehabMonitoring - Attendance & Activities",
        "width": 1366,
        "height": 850,
        "minWidth": 1024,
        "minHeight": 650,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false
      }
    }
  }
}